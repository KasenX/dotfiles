[alias]
  hist = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --
  ai-msg = "!bash \"$HOME/GitHub/scripts/git-ai-commit.sh\""

[user]
	name = Jakub Janeček
	email = kuba.rone@gmail.com
	signingkey = ~/.ssh/id_ed25519.pub
[includeIf "gitdir:~/CDN77/"]
  path = ~/.gitconfig-cdn77
[core]
	excludesfile = ~/.gitignore
	editor = nvim
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  dark = true
  side-by-side = true

[push]
  autoSetupRemote = true
  default = current

[fetch]
  prune = true
  pruneTags = true

[branch]
  sort = -committerdate

[tag]
  sort = version:refname

[diff]
  algorithm = histogram
  colorMoved = default
  mnemonicPrefix = true

[merge]
  conflictstyle = zdiff3

[rebase]
  autosquash = true
  autostash = true
  updateRefs = true

[rerere]
  enabled = true

[gpg]
	format = ssh

[commit]
	gpgsign = true
